<!-- McBar — Creado por Andrés Londero.
     Barra de menú superior: menú de McBar, nombre de la app activa con sus menús, y a la derecha
     bandeja, batería, red, volumen, búsqueda, Centro de control y reloj. -->
<Window x:Class="McBar.MenuBar.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="McBar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Width="1200" Height="28" Left="0" Top="0"
        FontFamily="{StaticResource Mc.Font}" FontSize="13">
    <Border x:Name="Root" Background="{DynamicResource Mc.MenuBarBg}">
        <DockPanel LastChildFill="False" Margin="8,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="LogoButton" Style="{StaticResource McFlatButton}" Padding="11,0" ToolTip="McBar">
                    <Grid Width="15" Height="13">
                        <Border BorderThickness="1.6" CornerRadius="3.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Border Height="3" Margin="3.5,0,3.5,2.6" VerticalAlignment="Bottom" CornerRadius="1.5"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>
                <Button x:Name="AppNameButton" Style="{StaticResource McFlatButton}">
                    <TextBlock x:Name="AppNameText" Text="Explorador" FontWeight="Bold"/>
                </Button>
                <Button x:Name="FileButton" Style="{StaticResource McFlatButton}" Content="Archivo"/>
                <Button x:Name="EditButton" Style="{StaticResource McFlatButton}" Content="Edición"/>
                <Button x:Name="ViewButton" Style="{StaticResource McFlatButton}" Content="Ver"/>
                <Button x:Name="WindowButton" Style="{StaticResource McFlatButton}" Content="Ventana"/>
                <Button x:Name="HelpButton" Style="{StaticResource McFlatButton}" Content="Ayuda"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="TrayButton" Style="{StaticResource McFlatButton}" ToolTip="Íconos de la bandeja de Windows">
                    <TextBlock FontFamily="{StaticResource Mc.Icons}" Text="&#xE70E;" FontSize="11"/>
                </Button>
                <Button x:Name="BatteryButton" Style="{StaticResource McFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BatteryText" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12.5"/>
                        <Grid Width="27" Height="13" VerticalAlignment="Center">
                            <Border Width="24" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="3.5" Opacity="0.55"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Border Width="2" Height="4.5" HorizontalAlignment="Right" Margin="0,0,0.5,0" CornerRadius="0,1.5,1.5,0" Opacity="0.55"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" Margin="2,2,0,2" Width="18" CornerRadius="1.8"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="BatteryBolt" Text="⚡" FontSize="9" Margin="0,0,3,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FFFFD60A" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Button>
                <Button x:Name="WifiButton" Style="{StaticResource McFlatButton}">
                    <TextBlock x:Name="WifiGlyph" FontFamily="{StaticResource Mc.Icons}" Text="&#xE701;" FontSize="14"/>
                </Button>
                <Button x:Name="VolumeButton" Style="{StaticResource McFlatButton}">
                    <TextBlock x:Name="VolumeGlyph" FontFamily="{StaticResource Mc.Icons}" Text="&#xE767;" FontSize="14"/>
                </Button>
                <Button x:Name="SearchButton" Style="{StaticResource McFlatButton}" ToolTip="Buscar apps">
                    <TextBlock FontFamily="{StaticResource Mc.Icons}" Text="&#xE721;" FontSize="13"/>
                </Button>
                <Button x:Name="ControlCenterButton" Style="{StaticResource McFlatButton}" ToolTip="Centro de control">
                    <Grid Width="16" Height="13">
                        <Border Height="5.5" VerticalAlignment="Top" CornerRadius="2.75" BorderThickness="1.3"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Ellipse Width="3.5" Height="3.5" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,1,1,0"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Border Height="5.5" VerticalAlignment="Bottom" CornerRadius="2.75" BorderThickness="1.3"
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Ellipse Width="3.5" Height="3.5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="1,0,0,1"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>
                <Button x:Name="ClockButton" Style="{StaticResource McFlatButton}" Padding="10,0">
                    <TextBlock x:Name="ClockText" FontSize="13"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
