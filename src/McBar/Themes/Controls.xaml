<!-- McBar — Creado por Andrés Londero.
     Estilos de controles con aspecto tipo macOS: menús redondeados, interruptores, deslizadores y botones.
     Los colores salen del tema activo (Dark.xaml / Light.xaml) con DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Mc.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mc.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mc.Emoji">Segoe UI Emoji, Segoe UI Symbol</FontFamily>

    <!-- ===== Menús ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10" Padding="5" CornerRadius="9" MinWidth="210"
                            Background="{DynamicResource Mc.PanelBg}" BorderBrush="{DynamicResource Mc.PanelBorder}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,5" Background="{DynamicResource Mc.Separator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="5" Padding="8,4,10,4" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="✓" FontSize="12" Visibility="Hidden" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                                       Opacity="0.55" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" FontSize="16" Margin="16,-2,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-15"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="10" Padding="5" CornerRadius="9" MinWidth="190"
                                        Background="{DynamicResource Mc.PanelBg}" BorderBrush="{DynamicResource Mc.PanelBorder}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mc.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Etiqueta emergente ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="8,4" CornerRadius="6" Background="{DynamicResource Mc.LabelBg}"
                            BorderBrush="{DynamicResource Mc.PanelBorder}" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botones ===== -->
    <Style x:Key="McButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Mc.TileBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mc.TileBorder}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="Over" CornerRadius="7" Background="{DynamicResource Mc.Hover}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Over" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Over" Property="Background" Value="{DynamicResource Mc.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McAccentButton" TargetType="Button" BasedOn="{StaticResource McButton}">
        <Setter Property="Background" Value="{DynamicResource Mc.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Mc.AccentText}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Botón plano para la barra de menú y los íconos -->
    <Style x:Key="McFlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Margin="1,3">
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Pressed}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="open">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Interruptor (CheckBox) ===== -->
    <Style x:Key="McSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="{DynamicResource Mc.Track}">
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Mc.Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="16" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Deslizador ===== -->
    <Style x:Key="McSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Mc.Accent}" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="McSliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="McThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="18" Height="18" Fill="White" Stroke="#26000000" StrokeThickness="0.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="McSlider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Mc.Track}" VerticalAlignment="Center" Margin="2,0"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource McSliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource McSliderEmpty}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource McThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Caja de texto ===== -->
    <Style x:Key="McTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Mc.Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{DynamicResource Mc.InputBg}"
                            BorderBrush="{DynamicResource Mc.PanelBorder}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Mc.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Control segmentado (RadioButton) ===== -->
    <Style x:Key="McSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Mc.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Mc.Font}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="14,5" Margin="2" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Mc.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mc.AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta (tile) del Centro de control y de los widgets -->
    <Style x:Key="McTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Mc.TileBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mc.TileBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!-- Ícono del Launchpad (dibujado, sin imágenes externas) -->
    <DrawingImage x:Key="Mc.LaunchpadIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M22,0 L106,0 A22,22 0 0 1 128,22 L128,106 A22,22 0 0 1 106,128 L22,128 A22,22 0 0 1 0,106 L0,22 A22,22 0 0 1 22,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF8E9BAE" Offset="0"/>
                            <GradientStop Color="#FF4A5568" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFF6B6B" Geometry="M28,28 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FFFFD166" Geometry="M55,28 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FF06D6A0" Geometry="M82,28 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FF4CC9F0" Geometry="M28,55 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FFF8F9FA" Geometry="M55,55 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FFB388EB" Geometry="M82,55 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FFF4A261" Geometry="M28,82 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FF4361EE" Geometry="M55,82 h18 v18 h-18 Z"/>
                <GeometryDrawing Brush="#FFEF476F" Geometry="M82,82 h18 v18 h-18 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
