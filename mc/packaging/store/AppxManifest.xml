<?xml version="1.0" encoding="utf-8"?>
<!-- McBar — Creado por Andrés Londero
     1.9.2: manifiesto del paquete MSIX para Microsoft Store. La versión (__VERSION__) la completa el
     workflow con la del .csproj (la Store exige que el último número sea 0).
     Identidad: tiene que coincidir EXACTO con Partner Center → McBar → Identidad del producto. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap5 desktop rescap virtualization">

  <Identity Name="Cocolopes.McBar"
            Publisher="CN=2F47ABAD-2E17-41CF-A530-D8B3386EC0F9"
            Version="__VERSION__"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>McBar</DisplayName>
    <PublisherDisplayName>Cocolopes</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Las opciones de Estilo Mac y "Abrir sin la espera de Windows" cambian estos ajustes de Windows del
         usuario (y los devuelven al apagarlas). Sin esto, Windows los guardaría solo dentro del paquete y no
         tendrían efecto. -->
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Control Panel\Cursors</virtualization:ExcludedKey>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\AppEvents\Schemes</virtualization:ExcludedKey>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize</virtualization:ExcludedKey>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Serialize</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
  </Resources>

  <Applications>
    <Application Id="McBar" Executable="McBar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="McBar"
        Description="Dock y barra de menú estilo macOS para Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Abrir McBar al iniciar Windows" (Preferencias → General) -->
        <desktop:Extension Category="windows.startupTask" Executable="McBar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="McBarStartup" Enabled="false" DisplayName="McBar" />
        </desktop:Extension>
        <!-- Alias para que McBar se pueda volver a abrir solo (con parámetros) si se traba -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="McBar.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="McBar.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
